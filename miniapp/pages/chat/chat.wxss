.page-shell,
.chat-layout {
  height: 100%;
}

.page-shell {
  background: #f5f6f7;
}

.chat-layout {
  display: flex;
  flex-direction: column;
}

.toolbar {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  min-height: 80rpx;
  padding: 0 28rpx;
  background: #ffffff;
  border-bottom: 1rpx solid #e8eaed;
  box-sizing: border-box;
}

.clear-button {
  margin: 0;
  padding: 0 8rpx;
  background: transparent;
  color: #079653;
  font-size: 28rpx;
  font-weight: 400;
  line-height: 64rpx;
}

.clear-button[disabled] {
  color: #9aa0a6;
  background: transparent;
}

.message-list {
  flex: 1;
  height: 0;
  min-height: 0;
}

.message-content {
  padding: 32rpx 28rpx 48rpx;
}

.message-row {
  display: flex;
  margin-bottom: 24rpx;
}

.message-row--user {
  justify-content: flex-end;
}

.message-row--assistant {
  justify-content: flex-start;
}

.message-bubble {
  max-width: 78%;
  padding: 22rpx 26rpx;
  border-radius: 24rpx;
  font-size: 31rpx;
  line-height: 1.55;
  word-break: break-word;
  white-space: pre-wrap;
  box-sizing: border-box;
}

.message-bubble--user {
  color: #ffffff;
  background: #08ad61;
  border-bottom-right-radius: 8rpx;
}

.message-bubble--assistant {
  color: #24272c;
  background: #ffffff;
  border: 1rpx solid #eaecf0;
  border-bottom-left-radius: 8rpx;
}

.message-bubble--pending {
  color: #777d85;
}

.message-bubble--image {
  width: 360rpx;
  padding: 0;
  overflow: hidden;
  background: transparent;
  border: 0;
  border-radius: 20rpx;
}

.message-image {
  display: block;
  width: 100%;
  border-radius: 20rpx;
}

.composer {
  flex: none;
  display: flex;
  align-items: flex-end;
  gap: 16rpx;
  padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  border-top: 1rpx solid #e3e5e8;
  box-sizing: border-box;
}

.message-input {
  flex: 1;
  width: auto;
  min-height: 76rpx;
  max-height: 180rpx;
  padding: 17rpx 22rpx;
  background: #f7f8f9;
  border: 1rpx solid #dfe2e6;
  border-radius: 18rpx;
  color: #202329;
  font-size: 30rpx;
  line-height: 42rpx;
  box-sizing: border-box;
}

.message-input-placeholder {
  color: #9ba0a8;
}

.image-button {
  flex: none;
  width: 92rpx;
  height: 78rpx;
  margin: 0;
  padding: 0;
  border: 1rpx solid #d8dce1;
  border-radius: 18rpx;
  background: #ffffff;
  color: #079653;
  font-size: 26rpx;
  line-height: 78rpx;
}

.image-button[disabled] {
  background: #f0f1f2;
  color: #9aa0a6;
}

.send-button {
  flex: none;
  width: 136rpx;
  height: 78rpx;
  margin: 0;
  padding: 0;
  border-radius: 18rpx;
  background: #08ad61;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 78rpx;
}

.send-button[disabled] {
  background: #9fd9bc;
  color: #ffffff;
}

.state-panel {
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  box-sizing: border-box;
}

.state-title {
  color: #4d535b;
  font-size: 30rpx;
  line-height: 1.5;
}

.retry-button {
  min-width: 176rpx;
  height: 76rpx;
  margin-top: 28rpx;
  border-radius: 18rpx;
  background: #08ad61;
  color: #ffffff;
  font-size: 30rpx;
  line-height: 76rpx;
}
