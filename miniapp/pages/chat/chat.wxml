<view class="page-shell">
  <view wx:if="{{loginStatus === 'loading'}}" class="state-panel">
    <view class="state-title">正在登录...</view>
  </view>

  <view wx:elif="{{loginStatus === 'error'}}" class="state-panel">
    <view class="state-title">登录失败，请重试</view>
    <button
      class="retry-button"
      loading="{{loginRetrying}}"
      disabled="{{loginRetrying}}"
      bindtap="retryLogin"
    >重试</button>
  </view>

  <view wx:else class="chat-layout">
    <view class="toolbar">
      <button
        class="clear-button"
        loading="{{clearing}}"
        disabled="{{clearing || sending || imageAnalyzing}}"
        bindtap="handleClearMemory"
      >清空记忆</button>
    </view>

    <scroll-view
      class="message-list"
      scroll-y
      enhanced
      show-scrollbar="{{false}}"
      scroll-with-animation
      scroll-into-view="{{scrollTarget}}"
    >
      <view class="message-content">
        <view
          wx:for="{{messages}}"
          wx:key="id"
          id="{{item.id}}"
          class="message-row message-row--{{item.role}}"
        >
          <view class="message-bubble message-bubble--{{item.role}} {{item.type === 'image' ? 'message-bubble--image' : ''}} {{item.pending ? 'message-bubble--pending' : ''}}">
            <image
              wx:if="{{item.type === 'image'}}"
              class="message-image"
              src="{{item.imagePath}}"
              mode="widthFix"
              show-menu-by-longpress
            />
            <text wx:else selectable="{{!item.pending}}">{{item.content}}</text>
          </view>
        </view>
      </view>
    </scroll-view>

    <view class="composer">
      <button
        class="image-button"
        loading="{{imageAnalyzing}}"
        disabled="{{sending || imageAnalyzing || clearing}}"
        bindtap="chooseImage"
        aria-label="选择图片或拍照"
      >图片</button>
      <textarea
        class="message-input"
        value="{{inputValue}}"
        placeholder="输入消息..."
        placeholder-class="message-input-placeholder"
        auto-height
        maxlength="-1"
        confirm-type="send"
        confirm-hold="{{true}}"
        disabled="{{sending || imageAnalyzing}}"
        bindinput="handleInput"
        bindconfirm="sendMessage"
      />
      <button
        class="send-button"
        loading="{{sending}}"
        disabled="{{sending || imageAnalyzing}}"
        bindtap="sendMessage"
      >发送</button>
    </view>
  </view>
</view>
